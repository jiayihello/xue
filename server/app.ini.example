# ZJMF-LXD 后端配置模板（app.ini.example）
# 请复制为 app.ini 并按需修改。
# 复制命令（示例）：cp server/app.ini.example server/app.ini

[server]
# 后端监听端口
HTTP_PORT = 8060

# 与魔方插件通信用的 API 密钥（必须修改为你自己的随机字符串）
TOKEN = <REPLACE_WITH_YOUR_TOKEN>

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL = INFO

[lxc]
# 默认镜像别名（可用 images: 前缀的远程镜像别名或本地别名）
# 例如：images:debian/12 或 images:alpine/3.19 或 debian12（如果已在本地定义别名）
DEFAULT_IMAGE_ALIAS = images:debian/12

# LXD 网络桥名称（通常为 lxdbr0）
NETWORK_BRIDGE = lxdbr0

# LXD 存储池名称
STORAGE_POOL = default

# 容器默认登录用户（用于设置初始密码等）
DEFAULT_CONTAINER_USER = root

# 宿主机对外主网卡名（例如 eth0, ens3, ens192 等）
# 该网卡用于 IPv4 NAT 的出网以及（如开启）IPv6 相关配置
MAIN_INTERFACE = eth0

# 宿主机端口转发的 IPv4 监听地址
# 强烈建议在公有云/EIP 场景使用 0.0.0.0（监听所有地址），不要填写云的 EIP
# 也可以填写本机实际存在的内网/公网 IPv4
NAT_LISTEN_IP = 0.0.0.0

# 端口映射连通性自检开关：
# true  = 严格模式：创建后立即自检，若容器端口未监听则回滚并报错（更安全、立即可用）
# false = 宽松模式：不阻断创建，失败只给出 warnings，稍后容器服务就绪后自动可用
PORTMAP_SELFTEST_STRICT = true

# ===================== IPv6 配置 =====================
# IPV6_MODE 取值：
#   OFF    ：禁用 IPv6 特性
#   ROUTED ：需要具备可路由的 /64 前缀；为容器分配独立 /128，并自动启用转发与 NDP 代理
#   NAT66  ：无需 /64；端口转发自动支持 v4+v6；并自动配置 SNAT 让容器通过宿主的 /128 出网
IPV6_MODE = OFF

# 当 IPV6_MODE = ROUTED 时，填写你的 /64 前缀，例如：2001:db8:abcd:1234::/64
# 注意：确保上游路由与 NDP proxy 生效；后端会在启动时尽力自愈：
#  - sysctl: net.ipv6.conf.all.forwarding=1
#  - sysctl: net.ipv6.conf.all.proxy_ndp=1 以及 net.ipv6.conf.<主网卡>.proxy_ndp=1
IPV6_PREFIX =

# IPv6 地址池（可选）：如果你有多个 /128 地址，可以在这里列出（用逗号或分号分隔）
# 系统会优先从地址池中分配，地址池耗尽后再从 IPV6_PREFIX 自动分配
# 示例：IPV6_ADDRESS_POOL = 2001:db8:1234::1, 2001:db8:1234::2, 2001:db8:1234::3
# 留空则直接从 IPV6_PREFIX 自动分配
IPV6_ADDRESS_POOL =

# IPv6 对外主网卡（可留空，默认沿用 MAIN_INTERFACE）
IPV6_INTERFACE =

# 当 IPV6_MODE = NAT66 时，填写宿主用于对外监听与 SNAT 的 /128（例如 2a01:db8::2/128）
# 若留空，则端口监听使用 ::（全部地址）；但为了让容器出网正常，仍建议提供一个稳定的 /128
NAT_LISTEN_IPV6 =

# ===================== 使用提示 =====================
# 1) 公有云/EIP 场景：
#    - NAT_LISTEN_IP 建议使用 0.0.0.0 或本机实际 IPv4；不要直接填 EIP，否则会出现 “Address not available”。
# 2) 宽松模式（PORTMAP_SELFTEST_STRICT=false）：
#    - 前端创建会成功，但若当时容器未监听，会在返回 JSON 的 warnings 字段中提示。
# 3) NAT66 出网：
#    - 后端会在启动时确保 IPv6 SNAT 规则（兼容 ip6tables 与 nftables），并禁用临时 IPv6 源地址。
# 4) ROUTED IPv6：
#    - 后端会为容器添加 routed 类型 IPv6 网卡和 NDP 代理项；需要你的上游/安全组允许 IPv6 通信。
# 5) 安全组/防火墙：
#    - 记得放行你对外公布的端口（IPv4/IPv6）。

